{
  "manifest_version": 3,
  "name": "Markdown Viewer - Tron Edition",
  "version": "1.0.0",
  "description": "Renders .md files with GitHub-style markdown and a dark neon Tron aesthetic",
  "permissions": ["activeTab", "storage", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": ["file:///*"],
      "include_globs": ["file:///*.md"],
      "js": ["lib/marked.min.js", "lib/highlight.min.js", "lib/purify.min.js", "rules.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["styles.css", "lib/github-dark.min.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
